# ─────────────────────────────────────────────────────────────
# Canaan Harvest Agribusiness — environment variables
# Copy to .env.local and fill in. Every route degrades gracefully
# to an in-process/dev fallback when a variable is absent, so the
# site is fully clickable without any keys.
# ─────────────────────────────────────────────────────────────

# ── Site ──────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://canaanharvest.co.ke
NODE_ENV=development

# ── reCAPTCHA v3 (brief §CAPTCHA) ─────────────────────────────
# Site key is public; secret key is server-only.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
# Score below this triggers the v2 fallback challenge.
RECAPTCHA_SCORE_THRESHOLD=0.5
NEXT_PUBLIC_RECAPTCHA_V2_SITE_KEY=
RECAPTCHA_V2_SECRET_KEY=

# ── Vercel KV — orders, subscriptions, zone data, newsletter ──
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=

# ── Vercel Blob — farm partner photo uploads ──────────────────
BLOB_READ_WRITE_TOKEN=

# ── Nodemailer — contact + order confirmations ────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Canaan Harvest <orders@canaanharvest.co.ke>"
MAIL_TO=orders@canaanharvest.co.ke

# ── WhatsApp Business notification ────────────────────────────
WHATSAPP_NUMBER=254112272061
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ── M-Pesa Daraja API — recurring subscription billing ────────
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://canaanharvest.co.ke/api/subscription/callback

# ── Google Maps — delivery zone embed ─────────────────────────
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_URL=
